(--line);box-shadow:0 -4px 14px rgba(0,0,0,.06)}\n.bottom-nav .wrap{display:flex;justify-content:space-between;padding-top:12px;padding-bottom:12px}\n.bottom-nav a{color:var(--ink);font-size:14px;font-weight:600;letter-spacing:.1em;padding:2px 4px}\n.bottom-nav a:hover,.bottom-nav a.hot{color:var(--orange)}\n\n@media (max-width:760px){\n  .grid-2,.faq-grid{grid-template-columns:1fr}\n  .grid-4{grid-template-columns:1fr 1fr}\n  section{padding:48px 0}\n  .bottom-nav a{font-size:12.5px;letter-spacing:.04em}\n  .bottom-nav .wrap{gap:4px}\n}\n</style><header id=\"top\">\n  <div class=\"hero-band-top\">\n    <div class=\"wrap\">\n      <span>NAIKO · 套餐 · 客户端 · 使用说明</span>\n      <span>一份写给新用户的完整指南</span>\n    </div>\n  </div>\n  <div class=\"hero-main\">\n    <div class=\"wrap\">\n      <h1>NaiKo</h1>\n      <p>从三档套餐到客户端导入，再到那些你迟早会问的问题——这一页把 NaiKo 的使用全流程一次讲完，省得你去各处翻找。</p>\n    </div>\n  </div>\n  <div class=\"hero-strip\">\n    <div class=\"wrap\">\n      <span>基础版 ¥15/月</span>\n      <span>旗舰版 ¥35/月</span>\n      <span>团队版 ¥85/月</span>\n      <span>均支持按年付费</span>\n    </div>\n  </div>\n  <div class=\"hero-thin\">SELECT PLAN · IMPORT · CONNECT</div>\n</header>\n\n<main>\n\n  <section id=\"about\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">01 / 开场白</span>\n        <h2>先说清楚：这一页是干什么的</h2>\n        <p class=\"lead\">作者视角的介绍，不绕弯子。</p>\n      </div>\n      <div class=\"prose\">\n        <p>大多数机场的介绍页，要么把套餐表甩给你就算完事，要么通篇形容词却找不到一句能落地的话。NaiKo 这页想反着来：先给你一张能横向对比的套餐表，再手把手讲清楚拿到订阅之后该做什么，最后把常见问题集中放在一处。</p>\n        <p>如果你是第一次接触这类服务，建议按顺序读完<em>套餐、使用说明、客户端、常见问题</em>四个部分，大概十分钟；如果你只是来比价的，直接跳到下面的对比表即可。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">02 / 套餐</span>\n        <h2>三档套餐，一张表横向比</h2>\n        <p class=\"lead\">价格与权益如下表所示；具体以订阅页实际展示为准。</p>\n      </div>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th class=\"feat-col\">对比项</th>\n              <th>基础版</th>\n              <th>旗舰版<span class=\"pill\">推荐</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15</span><span class=\"monthly\">每月</span></td>\n              <td><span class=\"price\">¥35</span><span class=\"monthly\">每月</span></td>\n              <td><span class=\"price\">¥85</span><span class=\"monthly\">每月</span></td>\n            </tr>\n            <tr class=\"dim\">\n              <th>年付价格</th>\n              <td><span class=\"annual\">按年付 ¥150/年</span></td>\n              <td><span class=\"annual\">按年付 ¥350/年</span></td>\n              <td><span class=\"annual\">按年付 ¥850/年</span></td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100GB 极速流量</td>\n              <td>300GB 极速流量</td>\n              <td>1000GB 极速流量</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>解锁基础流媒体</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>全节点解锁</td>\n            </tr>\n            <tr>\n              <th>线路与加速</th>\n              <td>普通线路节点池</td>\n              <td>IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>其他权益</th>\n              <td>—</td>\n              <td>7x24 优先工单支持</td>\n              <td>支持企业定制路由、专属客户经理服务</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <div class=\"prose\">\n        <p>怎么选，我的建议很简单：<em>一个人日常用，基础版够</em>；追原生流媒体、打游戏在意延迟，旗舰版的 IPLC 加速和优先工单值得多出的差价；如果是一个小团队共用，20 台设备加专属客户经理的团队版明显更划算。年付都比月付×12 便宜，确定会用满一年就别犹豫。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"guide\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">03 / 使用说明</span>\n        <h2>从零到连上，四步走完</h2>\n        <p class=\"lead\">整个过程不涉及任何复杂操作，照着做即可。</p>\n      </div>\n      <div class=\"grid-4\">\n        <div class=\"card\">\n          <div class=\"step-no\">STEP 01</div>\n          <h3>保存订阅信息</h3>\n          <p>开通后你会获得订阅链接与账号信息，第一时间妥善保存，这是后续所有步骤的入口。</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"step-no\">STEP 02</div>\n          <h3>导入客户端</h3>\n          <p>打开你惯用的机场客户端，在订阅设置里粘贴链接并更新，节点列表会自动同步下来。</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"step-no\">STEP 03</div>\n          <h3>挑选节点</h3>\n          <p>在列表里选择一个延迟表现可接受的节点，不确定就先从默认推荐开始。</p>\n        </div>\n        <div class=\"card\">\n          <div class=\"step-no\">STEP 04</div>\n          <h3>开启连接</h3>\n          <p>点击连接开关，状态显示已连接后即可正常使用，之后基本无需再管。</p>\n        </div>\n      </div>\n      <div class=\"card soft\">\n        <h3>几点使用习惯上的提醒</h3>\n        <p>同时在线设备数不要超套餐上限，超了容易顶掉线；一台设备长期不用，记得先断开再换设备；遇到打不开的情况，优先尝试切换节点或更新一次订阅，多数小问题都能这两招解决。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">04 / 客户端</span>\n        <h2>关于客户端，说点实话</h2>\n        <p class=\"lead\">没有下载地址，也不打算给你绕弯子。</p>\n      </div>\n      <div class=\"grid-2\">\n        <div class=\"card\">\n          <h3>不需要专属 App</h3>\n          <p>NaiKo 不搞独立客户端那一套。本页不提供下载地址——开通后你拿到的是接入信息，导入你手头已经在用的机场客户端即可，电脑和手机上的操作流程大体一致。</p>\n        </div>\n        <div class=\"card\">\n          <h3>换设备也不麻烦</h3>\n          <p>换新设备时，把同一个订阅链接再导入一次就行。注意各档位的同在线设备数上限：基础版 3 台、旗舰版 5 台、团队版 20 台，用不到的设备记得先断开。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"no\">05 / 常见问题</span>\n        <h2>双栏问答：你可能马上会问的八件事</h2>\n        <p class=\"lead\">答案基于上文套餐表与使用流程整理。</p>\n      </div>\n      <div class=\"faq-grid\">\n        <div class=\"faq-item\">\n          <h3>NaiKo 一共有几档套餐？</h3>\n          <p>共三档：基础版 ¥15/月（100GB、3 台设备）、旗舰版 ¥35/月（300GB、5 台设备、IPLC 游戏加速）、团队版 ¥85/月（1000GB、20 台设备、专属客户经理）。三档均支持按年付费，年付分别为 ¥150、¥350、¥850。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>按月付还是按年付划算？</h3>\n          <p>年付价格约为月付的十个月，相当于买一年省两个月。确定要长期用就选年付；只是先试试水，从月付开始更灵活。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>订购之后怎么开始使用？</h3>\n          <p>四步：保存好订阅链接 → 粘贴导入你惯用的客户端并更新 → 在节点列表里挑一个延迟可接受的节点 → 开启连接。详细说明见上文「使用说明」部分。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>需要下载专门的软件吗？</h3>\n          <p>不需要。NaiKo 没有专属 App，本页也不提供任何下载地址。开通后获取接入信息，导入你现有的机场客户端即可使用。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>一个账号能几台设备同时在线？</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。超出上限可能导致先前的设备被顶下线，长期不用的设备建议主动断开。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>每月流量会重置吗？用超了怎么办？</h3>\n          <p>各档位流量按月计算额度（100GB / 300GB / 1000GB）。如当月用量明显偏高，可考虑升级到更高档位；具体重置与升级规则以订阅页实际展示为准。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>遇到问题能找谁？</h3>\n          <p>旗舰版含 7x24 优先工单支持，团队版配有专属客户经理。基础版用户可通过常规咨询渠道反馈问题。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>连接不上或网页打不开怎么办？</h3>\n          <p>先按顺序排查：切换到其他节点 → 在客户端里手动更新一次订阅 → 检查同时在线设备是否超限。绝大多数小问题都能在前两步解决。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>NaiKo</strong>\n    <p>本页为 NaiKo 套餐、客户端与使用说明的介绍页。套餐价格与权益以订阅页实际展示为准；页面不提供任何客户端下载地址，也不会主动索取你的账号信息。</p>\n    <div class=\"foot-links\">\n      <a href=\"#top\">回到首屏</a>\n      <a href=\"#plans\">查看套餐</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#clients\">客户端说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>\n\n<nav class=\"bottom-nav\" aria-label=\"页面导航\">\n  <div class=\"wrap\">\n    <a href=\"#top\" class=\"hot\">NaiKo</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#guide\">使用说明</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n    <a href=\"#top\">回到顶部</a>\n  </div>\n</nav>",
